{
  "expo": {
    "name": "Cutie",
    "slug": "cutie-couples",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "couplesapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cutie.couplesapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Cutie to scan your partner's invite QR code."
      }
    },
    "android": {
      "package": "com.cutie.couplesapp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Cutie to scan your partner's invite QR code."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E11D48"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
